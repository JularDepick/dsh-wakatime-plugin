{
  "name": "dsh-wakatime-plugin",
  "version": "0.4.0",
  "description": "dsh 插件: 将 DSH 的每一次 Agent 交互量化为可视化表现指标并自动同步至 WakaTime,用数据展示你与 Agent 协作的生产力",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README_en-US.md",
    "COPYRIGHT"
  ],
  "license": "Apache-2.0",
  "author": "JularDepick",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <=0.2.1-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pack": "node scripts/pack.mjs",
    "postpack": "node scripts/pack.mjs --move-only",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.31",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <=0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  }
}